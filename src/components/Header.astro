---
import { profile } from '../data/profile';

const links = [
  { href: '#works', label: '制作事例' },
  { href: '#career', label: '経歴' },
  { href: '#skills', label: 'スキル' },
  ...(import.meta.env.PUBLIC_WEB3FORMS_KEY ? [{ href: '#contact', label: '連絡' }] : []),
];
---

<header class="absolute inset-x-0 top-0 z-10">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="#top" class="font-mincho text-lg font-bold tracking-wide" lang="en">{profile.name}</a>
    <nav aria-label="ページ内">
      <ul class="flex gap-6 text-sm">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="py-2 underline decoration-transparent underline-offset-8 transition-colors hover:decoration-mizu">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
