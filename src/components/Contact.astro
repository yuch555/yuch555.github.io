---
// 送信先メールアドレスは Web3Forms 側に登録する。コードにもリポジトリにも載せない。
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

const field =
  'mt-2 block w-full rounded-sm border border-sumi/40 bg-white px-4 py-3 text-base text-sumi focus:border-mizu';
---

{
  accessKey && (
    <section id="contact" class="border-t border-sumi/20">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
        <div class="grid gap-x-12 gap-y-8 md:grid-cols-[10rem_1fr]">
          <h2 class="font-mincho text-3xl font-bold">連絡</h2>
          <div class="max-w-xl">
            <p>お仕事のご相談や面談のご連絡は、こちらからお送りください。お返事はメールでお送りします。</p>

            <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="mt-8 space-y-6" novalidate>
              <input type="hidden" name="access_key" value={accessKey} />
              <input type="hidden" name="subject" value="ポートフォリオからのお問い合わせ" />
              <input type="hidden" name="from_name" value="ポートフォリオ" />
              <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

              <div>
                <label for="contact-name" class="block text-sm">お名前</label>
                <input id="contact-name" name="name" type="text" required maxlength="100" autocomplete="name" aria-describedby="contact-name-error" class={field} />
                <p id="contact-name-error" data-error-for="name" class="mt-2 text-sm text-[#b42318]" hidden></p>
              </div>
              <div>
                <label for="contact-email" class="block text-sm">メールアドレス</label>
                <input id="contact-email" name="email" type="email" required maxlength="200" autocomplete="email" aria-describedby="contact-email-error" class={field} />
                <p id="contact-email-error" data-error-for="email" class="mt-2 text-sm text-[#b42318]" hidden></p>
              </div>
              <div>
                <label for="contact-message" class="block text-sm">ご用件</label>
                <textarea id="contact-message" name="message" required maxlength="4000" rows="6" aria-describedby="contact-message-error" class={field} />
                <p id="contact-message-error" data-error-for="message" class="mt-2 text-sm text-[#b42318]" hidden></p>
              </div>

              <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
                <button
                  type="submit"
                  class="rounded-sm bg-sumi px-6 py-3 text-sm font-medium text-kiri transition-colors hover:bg-mizu disabled:opacity-50"
                >
                  送信する
                </button>
                <p id="contact-status" role="status" aria-live="polite" class="text-sm"></p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import type { ContactField } from '../scripts/contact-schema';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form && status && button) {
    // Zod は、フォームに触れたときに初めて読み込む
    let schema: Promise<typeof import('../scripts/contact-schema')> | undefined;
    const loadSchema = () => (schema ??= import('../scripts/contact-schema'));
    form.addEventListener('focusin', loadSchema, { once: true });

    const input = (field: string) => form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement;
    const errorBox = (field: string) => form.querySelector<HTMLElement>(`[data-error-for="${field}"]`)!;

    const setError = (field: string, message?: string) => {
      const box = errorBox(field);
      box.textContent = message ?? '';
      box.hidden = !message;
      if (message) input(field).setAttribute('aria-invalid', 'true');
      else input(field).removeAttribute('aria-invalid');
    };
    const setStatus = (text: string, tone: 'info' | 'ok' | 'error') => {
      status.className = `text-sm ${{ info: 'text-usu', ok: 'text-mizu', error: 'text-[#b42318]' }[tone]}`;
      status.textContent = text;
    };

    // 入力欄を離れたときに、その欄だけ確認する。直し始めたらエラーを消す。
    for (const field of ['name', 'email', 'message']) {
      input(field).addEventListener('blur', async () => {
        const value = input(field).value;
        if (!value) return;
        const { validateContactField } = await loadSchema();
        setError(field, validateContactField(field as ContactField, value));
      });
      input(field).addEventListener('input', () => setError(field));
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const { validateContact, contactFields } = await loadSchema();
      const checked = validateContact(Object.fromEntries(new FormData(form)));
      for (const field of contactFields) setError(field, checked.ok ? undefined : checked.errors[field]);
      if (!checked.ok) {
        setStatus('入力内容を確認してください。', 'error');
        input(contactFields.find((f) => checked.errors[f])!).focus();
        return;
      }

      button.disabled = true;
      setStatus('送信しています。', 'info');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), ...checked.data }),
        });
        const result = await res.json();
        if (!res.ok || !result.success) throw new Error(result.message);
        form.reset();
        setStatus('送信しました。内容を確認して、メールでお返事します。', 'ok');
      } catch {
        setStatus('送信できませんでした。時間をおいて、もう一度お試しください。', 'error');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
